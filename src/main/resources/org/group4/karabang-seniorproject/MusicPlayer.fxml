<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.group4.karabangApp.MusicPlayerController"
      spacing="15"
      alignment="CENTER"
      style="-fx-background-color: black;">

    <StackPane prefWidth="800" prefHeight="450">
        <MediaView fx:id="videoView"
                   fitWidth="800"
                   fitHeight="450"
                   preserveRatio="true"/>

        <Label fx:id="subtitleLabel"
               textFill="white"
               style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
    </StackPane>

    <HBox spacing="40"
          alignment="CENTER"
          prefWidth="800"
          style="
              -fx-background-color: white;
              -fx-padding: 15;
              -fx-background-radius: 15;
              -fx-border-radius: 15;
          ">

    <HBox spacing="10" alignment="BOTTOM_LEFT">

            <Button fx:id="playPauseButton"
                    onAction="#togglePlayPause"
                    style="-fx-background-color: transparent;">
                <graphic>
                    <ImageView fx:id="playPauseImage"
                               fitWidth="40"
                               fitHeight="40"
                               smooth="true"
                               preserveRatio="true"/>
                </graphic>
            </Button>

            <Button fx:id="restartButton"
                    onAction="#restart"
                    style="-fx-background-color: transparent;">
                <graphic>
                    <ImageView fx:id="restartImage"
                               fitWidth="40"
                               fitHeight="40"
                               smooth="true"
                               preserveRatio="true"/>
                </graphic>
            </Button>

        </HBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">

            <ImageView fx:id="volumeIcon"
                       fitWidth="40"
                       fitHeight="40"
                       smooth="true"
                       preserveRatio="true"/>

            <Slider fx:id="volumeSlider"
                    min="0"
                    max="1"
                    value="0.5"
                    prefWidth="150"/>

        </HBox>

    </HBox>

</VBox>