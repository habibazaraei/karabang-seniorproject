<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.group4.karabangApp.SongSelectionController">

    <!-- Background -->
    <ImageView fx:id="backgroundImageView" pickOnBounds="true" preserveRatio="false" smooth="true" />

    <!-- Main content overlay -->
    <VBox fx:id="songSelectionVBox" alignment="TOP_CENTER" spacing="20" stylesheets="@../../../CSS/SongSelection.css">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <!-- Header -->
        <Label fx:id="logoTitle" styleClass="header" text="KaraBang" />
        <Label fx:id="subtitle" styleClass="subtitle" text="Pick a Song"/>

        <HBox alignment="CENTER" spacing="20">

            <!-- Left area: search + scroll -->
            <VBox alignment="TOP_CENTER" spacing="10">
                <!-- Search Field -->
                <TextField fx:id="searchField" promptText="Search songs or artists..." styleClass="search-bar" />

                <!-- Scrollable song list -->
                <ScrollPane fx:id="songScrollPane" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" maxWidth="2000" prefWidth="1800" styleClass="scroll-pane" vbarPolicy="AS_NEEDED">
                    <VBox fx:id="songListVBox"  styleClass="scroll-pane-vbox"/>
                </ScrollPane>
            </VBox>

            <!-- Right song image -->
            <VBox fx:id="songVBox" alignment="CENTER" spacing="10">
                <ImageView fx:id="songImage" fitHeight="180" fitWidth="180" preserveRatio="true" />
                <Label fx:id="songName" styleClass="songTitle" text=" " />
                <Label fx:id="artistName" styleClass="songArtist" text=" " />
                <Button fx:id="singButton" styleClass="sing-button" text="Sing Now" />
            </VBox>

        </HBox>
    </VBox>
</StackPane>
